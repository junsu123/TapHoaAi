# Copy to backend/.env if you need to change defaults. No secrets belong here:
# the Claude API key is entered in the dashboard and stored encrypted (M4).
CHIBI_HOST=127.0.0.1
CHIBI_PORT=8000
# CHIBI_DATA_DIR=C:\ChibiLiveShop\data
CHIBI_DEMO_ENABLED=true
CHIBI_COOKIE_SECURE=false
CHIBI_MAX_VISIBLE_AVATARS=60
CHIBI_COMMAND_COOLDOWN_SECONDS=5
CHIBI_MAX_PENDING_PER_VIEWER=2
CHIBI_SHOW_SECONDS=8
CHIBI_RESERVATION_TTL_SECONDS=15
CHIBI_EVENT_RETENTION_DAYS=7
